#[id("b983100a-a932-51b7-afa4-f894c64ae1c8")]
/// A natural self-reference previously failed constant evaluation.
interface INode {
    /// Returns the explicit shared owner carried by the input value.
    fn echo(&self, input: &NodeInput) -> Result<ComPtr<INode>>;
}

/// Recursive owner-bearing input to the node's echo method.
struct NodeInput {
    node: ComPtr<INode>,
}

#[id("25fa4db1-7869-50d6-96a2-cd30c5280360")]
/// First half of a mutual reference, without storing a strong ownership cycle.
interface ILeft {
    /// Provides the opposing capability when available.
    fn right(&self) -> Result<ComPtr<IRight>>;
}

#[id("56e24810-4944-53f9-a3bf-8ff3bdb9c9fb")]
/// Second half of a mutually recursive contract.
interface IRight {
    /// Provides the opposing capability when available.
    fn left(&self) -> Result<ComPtr<ILeft>>;
}
