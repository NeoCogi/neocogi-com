/// Optional capability implemented by the example class.
#[version(2)]
interface IMeasured {
    /// Returns the current copied dimensions.
    fn extent(&self) -> Result<Extent>;
    /// Returns a short fresh report prefix, with required total separate from written count.
    fn reports(&self, output: &mut [ExtentReport]) -> Result<u32>;
}

/// Public object shape constructed only by `ExampleFactory`.
#[version(2)]
#[events(IExtentChangedEvent)]
interface ExampleObject: IMeasured {
    /// Replaces the dimensions using an exclusive implementation borrow.
    fn resize(&mut self, extent: Extent) -> Result<()>;
}

/// Typed construction surface for the example object.
#[version(2)]
interface ExampleFactory {
    /// Creates one initialized example object.
    fn create(&self, extent: Extent, events: &EventBinding) -> Result<ComPtr<ExampleObject>>;
}

/// Opaque composition exposes only its mountable root, never internal controls.
#[version(1)]
interface ICompositionRoot {
    /// Returns the root capability for a host-specific mount operation.
    fn take_root(&mut self) -> Result<ComBox<IUnknown>>;
    /// Resolves one authored child for a checked concrete class query.
    fn widget(&self, name: &[u8]) -> Result<WeakComBox<IUnknown>>;
}

#[version(2)]
/// Immutable extent snapshot carried by the common event receiver.
interface IExtentChangedEvent: neocogi::com::events::IEvent {
    /// Captured dimensions remain readable after producer destruction.
    fn extent(&self) -> Result<Extent>;
}
