use neocogi.com.events::EventBinding;
extern neocogi.com.events;
/// Copied dimensions used by the example object surface.
#[version(1)]
struct Extent {
    /// Horizontal extent.
    width: u32,
    /// Vertical extent.
    height: u32,
}

/// Concrete scalar event used by shared and monolithic typed-stream proofs.
#[version(1)]
struct ExtentChanged {
    /// Committed width.
    width: u32,
    /// Committed height.
    height: u32,
}

/// Copied payload enum used to verify one-way outputs across independently built plugins.
#[version(1)]
enum ExtentReport {
    /// Current dimensions and a recursively checked boolean.
    Current { extent: Extent, usable: bool },
    /// Unit variant leaves inactive payload bytes uninterpreted.
    Empty,
}
