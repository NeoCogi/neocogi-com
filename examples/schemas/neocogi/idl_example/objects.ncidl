/// Optional capability implemented by the example class.
interface IMeasured {
    /// Returns the current copied dimensions.
    fn extent(&self) -> Result<Extent>;
    /// Returns a short fresh report prefix, with required total separate from written count.
    fn reports(&self, output: &mut [ExtentReport]) -> Result<u32>;
}

/// Public object shape constructed only by `ExampleFactory`.
interface ExampleObject: IMeasured {
    /// Replaces the dimensions and notifies the observer after committing them.
    fn resize(&self, extent: Extent) -> Result<()>;
    /// Lends the optional transient caption while its field is borrowed.
    #[scoped]
    fn caption(&self) -> Result<Option<&INcString>>;
    /// Copies a new transient caption, or clears it when no value was supplied.
    fn set_caption(&self, caption: Option<&INcString>) -> Result<()>;
}

/// Typed construction surface for the example object.
interface ExampleFactory {
    /// Creates one initialized example object.
    fn create(&self, extent: Extent, events: &ExtentBinding) -> Result<ComPtr<ExampleObject>>;
}

/// Transfers the mountable composition to its new owner.
interface ICompositionRoot {
    /// Moves the sole owner of the mounted composition.
    fn take_root(&mut self) -> Result<ComBox<IMountedComposition>>;
}

/// The mounted object lends selected views of its owned children.
interface IMountedComposition {
    /// Lends the measured view of an authored child for this receiver borrow.
    fn widget(&self, name: &[u8]) -> Option<&IMeasured>;
}

/// Domain-specific observer; COM gives this interface no event semantics.
interface IExtentObserver {
    /// Captures an immutable extent and a non-owning producer identity.
    fn changed(&self, notification: &ExtentNotification) -> Result<()>;
}
