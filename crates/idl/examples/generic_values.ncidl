// The library is bundled with the compiler; no Cargo contract dependency is needed.
extern neocogi.lang;
use neocogi.lang::Option;

/// A live capability whose implementation is not a persistence value.
#[version(1)]
interface IToken {
    /// Reads a value from the supplied implementation.
    fn value(&self) -> Result<u32>;
}

/// The same generic enum can contain copied scalars, owned text, or owned COM refs.
#[version(1)]
struct OptionalValues {
    /// Copied tagged scalar, eligible for copied arguments and results.
    count: Option<u32>,
    /// Owned text; transport borrows the whole tagged enum during a call.
    text: Option<String>,
    /// Explicitly owned live object, independently retained when decoded.
    capability: Option<ComPtr<IToken>>,
    /// Boolean payload remains checked even inside the generic enum.
    flag: Option<bool>,
}

/// Demonstrates copied and borrowed use sites of the same ordinary enum template.
#[version(1)]
interface IValues {
    /// Copies a finite optional scalar in both directions.
    fn number(&mut self, value: Option<u32>) -> Result<Option<u32>>;
    /// Borrows the active text; the receiver acquires data before retaining it.
    fn text(&mut self, value: &Option<String>) -> Result<()>;
    /// Borrows a tagged capability; absence has its own enum tag.
    fn capability(&mut self, value: &Option<ComPtr<IToken>>) -> Result<u32>;
    /// Borrows an array of independently checked optional boolean elements.
    fn flags(&mut self, values: &Slice<Option<bool>>) -> Result<u32>;
}
