#[version(1)]
/// Borrowed buffers and consuming owners have separate positional storage.
interface IParameters {
    /// Source names cannot change any input value or the raw buffer bounds.
    fn buffers(&self, data: &[bool], nc_data_values: u32, nc_data_offset: u32, nc_data_len: u32, nc_data_ptr: u32, nc_arg_0: u32, nc_arg_0_values: u32, nc_arg_0_offset: u32, nc_arg_0_len: u32, nc_arg_0_ptr: u32) -> Result<u32>;
    /// Rejection restores the exact owner; success destroys it exactly once.
    fn owner(&self, status: ComBox<IToken>, result: bool) -> Result<u32>;
}
#[version(1)]
/// Observes a transferred owner's continued lifetime.
interface IToken { fn value(&self) -> Result<u32>; }
