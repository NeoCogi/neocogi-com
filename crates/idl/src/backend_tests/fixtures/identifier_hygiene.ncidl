/// Restricted first field forces checked conversion instead of a layout shortcut.
struct Record {
    first: bool, raw_0: u8, budget: u32, storage: u32, wire: u32, result: u32
}
/// Named, positional, and unit alternatives exercise both dispatch paths.
enum Choice {
    Named { first: bool, raw_0: u8, budget: u32 },
    Tuple(Record), Empty
}
/// Owned fields take the dynamic-budget traversal and retain indirect storage.
struct Owned { first: bool, raw_0: u8, budget: String, storage: Vec<Record> }
enum OwnedChoice { Named { first: bool, raw_0: u8, budget: String }, Empty }
interface IValues {
    fn record(&self, value: Record) -> Result<Record>;
    fn choice(&self, value: Choice) -> Result<Choice>;
    fn owned(&self, value: &Owned) -> Result<u32>;
}
/// Formerly reserved locals are ordinary authored argument names.
interface IArguments {
    fn buffers(&self, status: &mut [Record], result: &mut [Record], this: &[Record], object: u32) -> Result<u32>;
    fn scalars(&self, this: u32, object: u32, result: u32, status: u32) -> Result<u32>;
}
/// Distinct public names reach the provider even beside handle helpers.
interface ICapability {
    fn weak_capability(&self) -> Result<WeakComPtr<ICapability>>;
    fn clone_value(&self) -> Result<u32>;
    fn raw_value(&self) -> Result<u32>;
    fn helper_names(&self, clone: u32, downgrade: u32, query: u32) -> Result<u32>;
}

/// Weak keywords and names containing reserved words remain ordinary value fields.
struct KeywordRecord { union: bool, generation: u32, gen_value: u32 }
/// Named payload fields preserve weak keywords through checked enum conversion.
enum KeywordChoice { Named { safe: bool, raw: u32 } }
/// Member legality is shared with Rust 2024 without rejecting its weak keywords.
interface IKeywordNames {
    fn raw(&self, macro_rules: KeywordRecord, union: KeywordChoice) -> Result<KeywordRecord>;
}
