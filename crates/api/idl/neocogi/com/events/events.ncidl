#[version(1)]
/// A concrete message receiver; application closures and queue types remain local.
interface IMessageSink<T> {
    /// Validates and acquires the message before its call-scoped storage expires.
    fn post(&mut self, message: &T) -> Result<()>;
}

#[version(1)]
/// One complete typed stream owned by one behavioral parent for its lifetime.
interface IEventStream<E> {
    /// Installs the sole consumer. A second attachment fails without replacing it.
    fn attach(&mut self, consumer: &IMessageSink<E>) -> Result<()>;
}

#[version(1)]
/// Complete event-delivery choice supplied to a producer's constructor.
/// Unobserved is permanent for that instance; Observed retains exactly one
/// typed destination until logical closure or final producer destruction.
/// This is an ordinary generic enum, not special widget syntax.
enum EventBinding<E> {
    /// Construct without delivery; no later consumer installation is permitted.
    Unobserved,
    /// Retain the behavioral parent's typed receiver before publishing the object.
    Observed(ComPtr<IMessageSink<E>>),
}
