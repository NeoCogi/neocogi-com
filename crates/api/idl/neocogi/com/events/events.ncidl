#[version(1)]
/// Application-owned enqueue boundary for one concrete origin and event type.
/// Post acquires its payload and queues work; behavior runs after the caller's
/// mutable widget call returns. No handler/model pointer is retained by a widget.
interface IEventQueue<Object, Event> {
    /// Borrows the emitting object and snapshot for this synchronous call only.
    /// A queued origin should be weak unless the application deliberately needs ownership.
    fn post(&mut self, origin: &Object, event: &Event) -> Result<()>;
}

#[version(2)]
/// Permanent constructor delivery policy. Exactly one queue receives an object's
/// entire event enum. The application may share the same concrete queue object
/// among widgets and implement several closed IEventQueue interfaces on it.
enum EventBinding<Object, Event> {
    /// Permanently disable delivery for this instance, as in a designer preview.
    Unobserved,
    /// Retain the receiving queue until producer closure or final destruction.
    Observed(ComPtr<IEventQueue<Object, Event>>),
}
