struct NativeAggregate {
    tag: u8,
    count: u32,
    value: u64,
}

/// Fixed arrays nested in an ordinary copied record.
struct NativeArrayRecord {
    tag: u8,
    values: [[u32; 2]; 3],
    tail: u32,
}

/// Independently authored C uses the same by-value layout and buffer stride.
interface INativeArrays {
    fn rotate(&self, value: [u32; 3]) -> Result<[u32; 3]>;
    fn increment(&self, record: NativeArrayRecord) -> Result<NativeArrayRecord>;
    fn transfer(&self, input: &[[[u32; 2]; 2]], output: &mut [[[u32; 2]; 2]]) -> Result<()>;
}

#[id("7d83570c-632d-5dfb-b7f3-094248f1ba9e")]
interface INativeValue {
    fn value(&self) -> Result<i32>;
}

#[id("7ffa886f-0074-53cb-a828-5f031b786ee2")]
interface INativeCalculator: INativeValue {
    fn add(&self, a: i32, b: i32) -> Result<i32>;
    fn reset(&self) -> Result<()>;
    fn make_value(&self, value: i32) -> Result<ComPtr<INativeValue>>;
    fn read_value(&self, value: &INativeValue) -> Result<i32>;
    fn sum_buffer(&self, input: &[u8]) -> Result<u64>;
    fn fill_buffer(&self, output: &mut [u8]) -> Result<()>;
    fn transform(&self, input: NativeAggregate) -> Result<NativeAggregate>;
}

/// Native enum whose declaration-order tags and restricted bool cross the C boundary.
enum NativeChoice: i32 {
    /// A bool is represented as an unrestricted byte until checked decoding.
    Flag(bool),
    /// No payload storage is inspected for this variant.
    Empty,
}

#[id("6b32e8a9-7dc1-575f-9348-8616f657bcba")]
/// Independent C code calls this generated slot using only the explicit wire layout.
interface INativeChoice {
    /// Returns the checked native value unchanged through the generated output codec.
    fn echo(&self, value: NativeChoice) -> Result<NativeChoice>;
    /// Produces two values without reading old output bytes; returns required total.
    fn output(&self, output: &mut [NativeChoice]) -> Result<u32>;
    /// Uses direct projection of the copied value slot.
    fn copied(&self, mode: u32) -> NativeChoice;
    /// Exposes failure of the same copied value slot.
    fn checked_copied(&self, mode: u32) -> Result<NativeChoice>;
}

/// Independent C code exercises optional ownership and scoped borrowing of one value.
interface INativeCapability {
    fn find(&self, mode: u32) -> Option<ComPtr<INativeValue>>;
    fn load(&self, mode: u32) -> Result<Option<ComPtr<INativeValue>>>;
    #[scoped]
    fn observed(&self, mode: u32) -> Result<Option<&INativeValue>>;
    fn read(&self, loan: Option<&INativeValue>) -> Result<i32>;
    fn invalidate(&self) -> Result<()>;
    fn invalidate_borrowed(&self, target: &mut INativeBoxedActions);
    fn stable(&self, mode: u32) -> Result<Option<&INativeValue>>;
    fn direct_loan(&self, mode: u32) -> Option<&INativeValue>;
}

/// Required loans from a unique receiver, with optional scoped mutation.
interface INativeBoxedActions {
    fn find(&self) -> Option<ComPtr<INativeValue>>;
    fn invalidate(&mut self);
    fn child(&self) -> Result<&INativeBoxedActions>;
    fn child_mut(&mut self) -> Result<&mut INativeBoxedActions>;
    #[scoped]
    fn visit_child(&mut self) -> Option<&mut INativeBoxedActions>;
}
